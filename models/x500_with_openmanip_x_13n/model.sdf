<?xml version="1.0" encoding="UTF-8"?>
<!--
  Composed model: PX4 x500 quadcopter with 13 N motors + ROBOTIS OpenManipulator-X.
  Kinematics, masses, centres of mass, inertias and joint limits are the
  upstream ROBOTIS values (see arms/openmanip_x/urdf/openmanip_x.urdf.xacro,
  which this file must match: test/test_arm_kinematics.py). Geometry is
  boxes, not the upstream meshes. The arm hangs below base_link (mount
  0.05 m down, roll = pi) and starts in the stow pose set by the
  ros2_control initial_value in the URDF. The gripper's two fingers are
  prismatic joints; gz_ros2_control drives the right one as the URDF's
  mimic of the left. Pads grip with friction 1.0 (Gazebo takes the lower
  of the two surfaces' values).
  Joint commands routed through gz_ros2_control (see plugin below).
-->
<sdf version='1.9'>
  <model name='x500_with_openmanip_x_13n'>

    <include merge='true'>
      <uri>model://x500_base</uri>
    </include>

    <!-- The x500's motor plugins with 13 N per rotor (stock model: 8.5 N), a
         modelling assumption, not a real part. On the stock motors this drone
         hovers at 0.85 of full thrust and fell after simulator stalls in the
         pick flights: see docs/AERIAL_ARM.md. Everything else is
         models/x500_with_openmanip_x (test/test_arm_kinematics.py checks). -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>1.3e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>1.3e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>1.3e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>1.3e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <link name='openmanip_x_link1'>
      <pose relative_to='base_link'>0 0 -0.05 3.14159 0 0</pose>
      <inertial>
        <mass>0.079119962</mass>
        <pose>3.0876154e-04 0 -1.2176461e-04 0 0 0</pose>
        <inertia>
          <ixx>1.2505234e-05</ixx><iyy>2.1898364e-05</iyy><izz>1.9267361e-05</izz>
          <ixy>0</ixy><ixz>-1.7855208e-07</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='openmanip_x_link1_visual'>
        <pose>0.012 0 0.0085 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.017</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <collision name='openmanip_x_link1_collision'>
        <pose>0.012 0 0.0085 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.017</size></box></geometry>
      </collision>
    </link>
    <joint name='arm_mount' type='fixed'>
      <parent>base_link</parent>
      <child>openmanip_x_link1</child>
    </joint>
    <link name='openmanip_x_link2'>
      <pose relative_to='openmanip_x_link1'>0.012 0 0 0 0 0</pose>
      <inertial>
        <mass>0.098406837</mass>
        <pose>-3.0184870e-04 5.4043684e-04 4.7433464e-02 0 0 0</pose>
        <inertia>
          <ixx>3.4543422e-05</ixx><iyy>3.2689329e-05</iyy><izz>1.885032e-05</izz>
          <ixy>-1.6031095e-08</ixy><ixz>-3.8375155e-07</ixz><iyz>2.8511935e-08</iyz>
        </inertia>
      </inertial>
      <visual name='openmanip_x_link2_visual'>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.045 0.0595</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <collision name='openmanip_x_link2_collision'>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.045 0.0595</size></box></geometry>
      </collision>
    </link>
    <joint name='joint1' type='revolute'>
      <parent>openmanip_x_link1</parent>
      <child>openmanip_x_link2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.14159</lower><upper>3.14159</upper>
               <effort>4.1</effort><velocity>4.8</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>
    <link name='openmanip_x_link3'>
      <pose relative_to='openmanip_x_link2'>0 0 0.0595 0 0 0</pose>
      <inertial>
        <mass>0.13850917</mass>
        <pose>1.0308393e-02 3.7743363e-04 1.0170197e-01 0 0 0</pose>
        <inertia>
          <ixx>0.00033055381</ixx><iyy>0.00034290447</iyy><izz>6.0346498e-05</izz>
          <ixy>-9.7940978e-08</ixy><ixz>-3.8505711e-05</ixz><iyz>-1.5717516e-06</iyz>
        </inertia>
      </inertial>
      <visual name='openmanip_x_link3_visual'>
        <pose>0.012 0 0.064 0 0 0</pose>
        <geometry><box><size>0.035 0.03 0.15</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <collision name='openmanip_x_link3_collision'>
        <pose>0.012 0 0.064 0 0 0</pose>
        <geometry><box><size>0.035 0.03 0.15</size></box></geometry>
      </collision>
    </link>
    <joint name='joint2' type='revolute'>
      <parent>openmanip_x_link2</parent>
      <child>openmanip_x_link3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.5</lower><upper>1.5</upper>
               <effort>4.1</effort><velocity>4.8</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>
    <link name='openmanip_x_link4'>
      <pose relative_to='openmanip_x_link3'>0.024 0 0.128 0 0 0</pose>
      <inertial>
        <mass>0.13274562</mass>
        <pose>9.0909590e-02 3.8929816e-04 2.2413279e-04 0 0 0</pose>
        <inertia>
          <ixx>3.0654178e-05</ixx><iyy>0.00024230292</iyy><izz>0.00025155057</izz>
          <ixy>-1.2764155e-06</ixy><ixz>-2.6874417e-07</ixz><iyz>1.155955e-08</iyz>
        </inertia>
      </inertial>
      <visual name='openmanip_x_link4_visual'>
        <pose>0.062 0 0 0 0 0</pose>
        <geometry><box><size>0.124 0.03 0.03</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <collision name='openmanip_x_link4_collision'>
        <pose>0.062 0 0 0 0 0</pose>
        <geometry><box><size>0.124 0.03 0.03</size></box></geometry>
      </collision>
    </link>
    <joint name='joint3' type='revolute'>
      <parent>openmanip_x_link3</parent>
      <child>openmanip_x_link4</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.5</lower><upper>1.4</upper>
               <effort>4.1</effort><velocity>4.8</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>
    <link name='openmanip_x_link5'>
      <pose relative_to='openmanip_x_link4'>0.124 0 0 0 0 0</pose>
      <inertial>
        <mass>0.14327573</mass>
        <pose>4.4206755e-02 3.6839985e-07 8.9142216e-03 0 0 0</pose>
        <inertia>
          <ixx>8.0870749e-05</ixx><iyy>7.5980465e-05</iyy><izz>9.3127351e-05</izz>
          <ixy>0</ixy><ixz>-1.0157896e-06</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='openmanip_x_link5_visual'>
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.05 0.03</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <collision name='openmanip_x_link5_collision'>
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.05 0.03</size></box></geometry>
      </collision>
      <!-- Wrist camera, looking along the gripper (link5 x) from 3 cm off its axis on
           the -z side: with the gripper pointing down that is ahead of it, towards the
           pick world's marker. No distortion; not on the real arm (a small USB camera
           would sit here). Its frame: x the optical axis, image right = -y, down = -z. -->
      <sensor name='wrist_camera' type='camera'>
        <pose>0.06 0 -0.03 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.03</near><far>5</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
      </sensor>
    </link>
    <joint name='joint4' type='revolute'>
      <parent>openmanip_x_link4</parent>
      <child>openmanip_x_link5</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.7</lower><upper>1.97</upper>
               <effort>4.1</effort><velocity>4.8</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
      <!-- Wrist force/torque, in link5's frame: the hand's weight plus whatever the
           fingers touch. Not on the real arm (its servos report current instead). -->
      <sensor name='wrist_ft' type='force_torque'>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque>
      </sensor>
    </joint>
    <link name='end_effector_link'>
      <pose relative_to='openmanip_x_link5'>0.126 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>1e-8</ixx><iyy>1e-8</iyy><izz>1e-8</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- No visual here (the URDF has a yellow ball for RViz): it would sit in front of the
           wrist camera and hide the pick world's marker. -->
    </link>
    <joint name='j_ee' type='fixed'>
      <parent>openmanip_x_link5</parent>
      <child>end_effector_link</child>
    </joint>
    <link name='gripper_left_link'>
      <pose relative_to='openmanip_x_link5'>0.0817 0.021 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='gripper_left_visual'>
        <pose>0.02215 0.002 0 0 0 0</pose>
        <geometry><box><size>0.0443 0.006 0.02</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <collision name='gripper_left_collision'>
        <pose>0.02215 0.002 0 0 0 0</pose>
        <geometry><box><size>0.0443 0.006 0.02</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name='gripper_left_joint' type='prismatic'>
      <parent>openmanip_x_link5</parent>
      <child>gripper_left_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.010</lower><upper>0.019</upper>
               <effort>1</effort><velocity>4.8</velocity></limit>
      </axis>
    </joint>
    <link name='gripper_right_link'>
      <pose relative_to='openmanip_x_link5'>0.0817 -0.021 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='gripper_right_visual'>
        <pose>0.02215 -0.002 0 0 0 0</pose>
        <geometry><box><size>0.0443 0.006 0.02</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <collision name='gripper_right_collision'>
        <pose>0.02215 -0.002 0 0 0 0</pose>
        <geometry><box><size>0.0443 0.006 0.02</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- The real fingers are one motor and a linkage: they cannot push against each
         other. Here the right one only follows the left's position (gz_ros2_control's
         mimic), and at the same 1 N limit a held part sat in a tug of war between them
         and slipped out on lifting. 5 N lets it hold its place like the linkage would;
         the left one still sets the squeeze (1 N). -->
    <joint name='gripper_right_joint' type='prismatic'>
      <parent>openmanip_x_link5</parent>
      <child>gripper_right_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>-0.010</lower><upper>0.019</upper>
               <effort>5</effort><velocity>4.8</velocity></limit>
      </axis>
    </joint>

    <!-- Ground truth for measuring, never for control: /model/<name>/pose. -->
    <plugin filename='gz-sim-pose-publisher-system' name='gz::sim::systems::PosePublisher'>
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>

    <plugin filename='libgz_ros2_control-system.so'
            name='gz_ros2_control::GazeboSimROS2ControlPlugin'>
      <parameters>@UAVROS2_PKG_SHARE@/arms/openmanip_x/config/controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
      <ros>
        <namespace>@UAVROS2_NAMESPACE@</namespace>
      </ros>
    </plugin>

  </model>
</sdf>
