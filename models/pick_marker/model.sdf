<?xml version="1.0"?>
<!-- ArUco marker DICT_4X4_50 id 0, flat, facing up (+z). The black square is 4.4 cm
     (the texture's 360 of 450 px); the white card around it 5.5 cm. Visual only: no
     collision, so the gripper touches the surface under it. -->
<sdf version="1.9">
  <model name="pick_marker">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0.0005 0 0 0</pose>
        <geometry><box><size>0.055 0.055 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <ambient>1 1 1 1</ambient>
          <pbr><metal>
            <albedo_map>model://pick_marker/materials/textures/aruco_4x4_50_id0.png</albedo_map>
            <metalness>0</metalness><roughness>1</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
