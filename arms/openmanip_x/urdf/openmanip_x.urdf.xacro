<?xml version="1.0"?>
<!--
  ROBOTIS OpenManipulator-X, mounted under the x500 (hangs below base_link).

  Kinematics, masses, centres of mass, inertias and joint limits are the
  upstream values from ROBOTIS-GIT/open_manipulator (Apache-2.0,
  open_manipulator_description/urdf/open_manipulator_x/open_manipulator_x_arm.urdf.xacro):
    joint1  yaw   (Z)  0.012 m along X from the base plate
    joint2  pitch (Y)  0.0595 m above joint1
    joint3  pitch (Y)  (0.024, 0, 0.128) from joint2
    joint4  pitch (Y)  0.124 m along X from joint3
    end_effector       0.126 m along X from joint4
  Total arm mass 0.594 kg (the gripper fingers' 2 g are folded into link5;
  the fingers themselves are not modelled). Visual / collision geometry is
  boxes sized to each link instead of the upstream STL meshes.
  Effort limit 4.1 N m: Dynamixel XM430-W350 stall torque at 12 V.

  Pairs with models/x500_with_openmanip_x/model.sdf (test_arm_kinematics.py
  checks they agree). The arm starts folded in the stow pose (initial_value
  below) because straight down it would reach 0.45 m, past the landing gear.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openmanip_x">

  <!-- Stow pose: upper arm swung back, forearm folded forward; every point of
       the arm stays above z = -0.17 m (gear feet at -0.2195 m). -->
  <xacro:property name="stow_j1" value="0.0"/>
  <xacro:property name="stow_j2" value="-1.5"/>
  <xacro:property name="stow_j3" value="1.4"/>
  <xacro:property name="stow_j4" value="1.5"/>

  <xacro:macro name="omx_link" params="name mass com ixx iyy izz ixy ixz iyz box box_xyz rgba">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="${com}" rpy="0 0 0"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
      <visual>
        <origin xyz="${box_xyz}" rpy="0 0 0"/>
        <geometry><box size="${box}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${box_xyz}" rpy="0 0 0"/>
        <geometry><box size="${box}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="omx_joint" params="name parent child xyz axis lower upper">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="4.1" velocity="4.8"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>
  </xacro:macro>

  <link name="base_link"/>

  <!-- Base plate, fixed to the drone. -->
  <xacro:omx_link name="openmanip_x_link1" mass="7.9119962e-02"
      com="3.0876154e-04 0 -1.2176461e-04"
      ixx="1.2505234e-05" iyy="2.1898364e-05" izz="1.9267361e-05"
      ixy="0" ixz="-1.7855208e-07" iyz="0"
      box="0.045 0.045 0.017" box_xyz="0.012 0 0.0085" rgba="0.25 0.25 0.25 1"/>
  <joint name="arm_mount" type="fixed">
    <parent link="base_link"/>
    <child link="openmanip_x_link1"/>
    <!-- Mount: 5 cm below base_link, flipped (roll = pi) so the chain hangs
         down; must match models/<uav>/model.sdf and asset.yaml mount_*. -->
    <origin xyz="0 0 -0.05" rpy="3.14159 0 0"/>
  </joint>

  <xacro:omx_link name="openmanip_x_link2" mass="9.8406837e-02"
      com="-3.0184870e-04 5.4043684e-04 4.7433464e-02"
      ixx="3.4543422e-05" iyy="3.2689329e-05" izz="1.8850320e-05"
      ixy="-1.6031095e-08" ixz="-3.8375155e-07" iyz="2.8511935e-08"
      box="0.03 0.045 0.0595" box_xyz="0 0 0.03" rgba="0.85 0.85 0.85 1"/>
  <xacro:omx_joint name="joint1" parent="openmanip_x_link1" child="openmanip_x_link2"
      xyz="0.012 0 0" axis="0 0 1" lower="-3.14159" upper="3.14159"/>

  <xacro:omx_link name="openmanip_x_link3" mass="1.3850917e-01"
      com="1.0308393e-02 3.7743363e-04 1.0170197e-01"
      ixx="3.3055381e-04" iyy="3.4290447e-04" izz="6.0346498e-05"
      ixy="-9.7940978e-08" ixz="-3.8505711e-05" iyz="-1.5717516e-06"
      box="0.035 0.03 0.15" box_xyz="0.012 0 0.064" rgba="0.25 0.25 0.25 1"/>
  <xacro:omx_joint name="joint2" parent="openmanip_x_link2" child="openmanip_x_link3"
      xyz="0 0 0.0595" axis="0 1 0" lower="-1.5" upper="1.5"/>

  <xacro:omx_link name="openmanip_x_link4" mass="1.3274562e-01"
      com="9.0909590e-02 3.8929816e-04 2.2413279e-04"
      ixx="3.0654178e-05" iyy="2.4230292e-04" izz="2.5155057e-04"
      ixy="-1.2764155e-06" ixz="-2.6874417e-07" iyz="1.1559550e-08"
      box="0.124 0.03 0.03" box_xyz="0.062 0 0" rgba="0.85 0.85 0.85 1"/>
  <xacro:omx_joint name="joint3" parent="openmanip_x_link3" child="openmanip_x_link4"
      xyz="0.024 0 0.128" axis="0 1 0" lower="-1.5" upper="1.4"/>

  <!-- Wrist + gripper (fingers' mass included). -->
  <xacro:omx_link name="openmanip_x_link5" mass="1.4527573e-01"
      com="4.4206755e-02 3.6839985e-07 8.9142216e-03"
      ixx="8.0870749e-05" iyy="7.5980465e-05" izz="9.3127351e-05"
      ixy="0" ixz="-1.0157896e-06" iyz="0"
      box="0.10 0.05 0.03" box_xyz="0.05 0 0" rgba="0.25 0.25 0.25 1"/>
  <xacro:omx_joint name="joint4" parent="openmanip_x_link4" child="openmanip_x_link5"
      xyz="0.124 0 0" axis="0 1 0" lower="-1.7" upper="1.97"/>

  <link name="end_effector_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="ee_mat"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>
  <joint name="j_ee" type="fixed">
    <parent link="openmanip_x_link5"/>
    <child link="end_effector_link"/>
    <origin xyz="0.126 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:arg name="sim_mode" default="gz"/>
  <xacro:macro name="omx_control_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <ros2_control name="openmanip_x_hw" type="system">
    <hardware>
      <xacro:if value="${'$(arg sim_mode)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="${'$(arg sim_mode)' == 'gz'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:unless>
    </hardware>
    <xacro:omx_control_joint name="joint1" initial="${stow_j1}"/>
    <xacro:omx_control_joint name="joint2" initial="${stow_j2}"/>
    <xacro:omx_control_joint name="joint3" initial="${stow_j3}"/>
    <xacro:omx_control_joint name="joint4" initial="${stow_j4}"/>
  </ros2_control>

</robot>
