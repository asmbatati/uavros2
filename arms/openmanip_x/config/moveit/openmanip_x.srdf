<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic robot description for the OpenManipulator-X (upstream ROBOTIS
  kinematics, hung under the x500).

  Planning group "arm" covers all 4 joints. The base for IK is
  base_link (the mount frame to the x500 in the composed model);
  end-effector link is end_effector_link.
-->
<robot name="openmanip_x">

  <group name="arm">
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
  </group>

  <!-- The fingers; the right one mimics the left. Not in the contact-tool
       URDF, where MoveIt warns and ignores the group. -->
  <group name="gripper">
    <joint name="gripper_left_joint"/>
  </group>
  <end_effector name="gripper" parent_link="openmanip_x_link5" group="gripper" parent_group="arm"/>

  <!-- home = the stow pose the arm spawns in (fits above the landing gear) -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="-1.1"/>
    <joint name="joint3" value="1.2"/>
    <joint name="joint4" value="0.9"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_left_joint" value="0.019"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="gripper_left_joint" value="-0.010"/>
  </group_state>
  <group_state name="reach" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0.8"/>
    <joint name="joint3" value="-0.3"/>
    <joint name="joint4" value="0.4"/>
  </group_state>

  <!-- Adjacent-link collision disables -->
  <disable_collisions link1="base_link" link2="openmanip_x_link1" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link1" link2="openmanip_x_link2" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link2" link2="openmanip_x_link3" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link3" link2="openmanip_x_link4" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link4" link2="openmanip_x_link5" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link5" link2="end_effector_link" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link5" link2="gripper_left_link" reason="Adjacent"/>
  <disable_collisions link1="openmanip_x_link5" link2="gripper_right_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Never"/>

</robot>
